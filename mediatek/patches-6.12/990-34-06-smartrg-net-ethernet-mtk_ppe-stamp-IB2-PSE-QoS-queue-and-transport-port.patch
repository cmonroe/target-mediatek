From: Chad Monroe <chad@monroe.io>
Date: Fri, 15 May 2026 13:43:18 -0700
Subject: [PATCH] net: ethernet: mtk_ppe: stamp IB2 PSE QoS queue and transport port

Wire PPPQ into the offloader. mtk_flow_set_output_device() picks the
egress queue with the PPPQ formula and stamps it via
mtk_foe_entry_set_queue(). On netsys v3 the new MTK_FOE_TPORT_IDX field
must also be 1 for the QDMA HQoS block to see the flow; struct
mtk_foe_mac_info gains tport/tinfo (tinfo is positional padding for the
hardware-expected tport offset). mtk_ppe_check_pppq_path() gates
admission so non-eligible egresses keep IB2 at zero.

Based-on-patch-by: Bo-Cun Chen <bc-bocun.chen@mediatek.com>
Based-on-patch-by: chak-kei.lam <chak-kei.lam@mediatek.com>
Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.h     |    1 
 drivers/net/ethernet/mediatek/mtk_ppe.c         |   11 +++++++
 drivers/net/ethernet/mediatek/mtk_ppe.h         |    4 ++
 drivers/net/ethernet/mediatek/mtk_ppe_offload.c |   22 +++++++++-----
 4 files changed, 31 insertions(+), 7 deletions(-)

--- a/drivers/net/ethernet/mediatek/mtk_ppe.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.c
@@ -490,6 +490,17 @@ int mtk_foe_entry_set_queue(struct mtk_e
 		*ib2 |= MTK_FOE_IB2_PSE_QOS;
 	}
 
+	/* Netsys v3 routes packets through QDMA only when the transport
+	 * port index is set; leaving it at 0 keeps the flow out of the
+	 * QDMA scheduler regardless of IB2_PSE_QOS.
+	 */
+	if (mtk_is_netsys_v3_or_greater(eth)) {
+		struct mtk_foe_mac_info *l2 = mtk_foe_entry_l2(eth, entry);
+
+		l2->tport &= ~MTK_FOE_TPORT_IDX;
+		l2->tport |= FIELD_PREP(MTK_FOE_TPORT_IDX, 1);
+	}
+
 	return 0;
 }
 
--- a/drivers/net/ethernet/mediatek/mtk_ppe.h
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.h
@@ -96,6 +96,8 @@ enum {
 #define MTK_FOE_WINFO_AMSDU_HF		BIT(23)
 #define MTK_FOE_WINFO_AMSDU_EN		BIT(24)
 
+#define MTK_FOE_TPORT_IDX		GENMASK(3, 0)
+
 enum {
 	MTK_FOE_STATE_INVALID,
 	MTK_FOE_STATE_UNBIND,
@@ -124,6 +126,8 @@ struct mtk_foe_mac_info {
 	/* netsys_v3 */
 	u32 w3info;
 	u32 amsdu;
+	u16 tinfo;	/* structural: positions tport at the silicon-expected offset */
+	u16 tport;
 };
 
 /* software-only entry type */
--- a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
@@ -193,6 +193,7 @@ mtk_flow_set_output_device(struct mtk_et
 			   int *wed_index)
 {
 	struct mtk_wdma_info info = {};
+	struct mtk_mac *mac;
 	int pse_port, dsa_port, queue;
 
 	if (mtk_flow_get_wdma_info(dev, dest_mac, &info) == 0) {
@@ -221,22 +222,29 @@ mtk_flow_set_output_device(struct mtk_et
 
 	dsa_port = mtk_flow_get_dsa_port(&dev);
 
-	if (dev == eth->netdev[0])
+	if (dev == eth->netdev[0]) {
+		mac = eth->mac[0];
 		pse_port = PSE_GDM1_PORT;
-	else if (dev == eth->netdev[1])
+	} else if (dev == eth->netdev[1]) {
+		mac = eth->mac[1];
 		pse_port = PSE_GDM2_PORT;
-	else if (dev == eth->netdev[2])
+	} else if (dev == eth->netdev[2]) {
+		mac = eth->mac[2];
 		pse_port = PSE_GDM3_PORT;
-	else
+	} else {
 		return -EOPNOTSUPP;
+	}
 
 	if (dsa_port >= 0) {
 		mtk_foe_entry_set_dsa(eth, foe, dsa_port);
-		queue = 3 + dsa_port;
+		queue = MTK_MAX_DEVS + eth->pppq_ofs[mac->id] +
+			mac->dsa_user_idx[dsa_port];
 	} else {
-		queue = pse_port - 1;
+		queue = (pse_port == PSE_GDM3_PORT) ? 2 : pse_port - 1;
 	}
-	mtk_foe_entry_set_queue(eth, foe, queue);
+
+	if (mtk_ppe_check_pppq_path(dsa_port))
+		mtk_foe_entry_set_queue(eth, foe, queue);
 
 out:
 	mtk_foe_entry_set_pse_port(eth, foe, pse_port);
