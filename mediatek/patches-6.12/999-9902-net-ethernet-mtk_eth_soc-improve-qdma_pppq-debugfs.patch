From: Chad Monroe <chad@monroe.io>
Date: Tue, 09 Dec 2025 15:01:26 -0800
Subject: [PATCH] net: ethernet: mediatek: improve qdma_pppq debugfs

Enable qdma_pppq debugfs for all netsys versions, not just v3+. Read
scheduler and weight registers on netsys v1 using the correct field
mask. Add packet/drop counters (v2+ only), identify ACK queues in
interface column.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/mediatek/mtk_eth_dbg.c |   60 +++++++++++++++---
 1 file changed, 51 insertions(+), 9 deletions(-)

--- a/drivers/net/ethernet/mediatek/mtk_eth_dbg.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_dbg.c
@@ -71,10 +71,14 @@ struct mtk_eth_debug eth_debug;
 static int mtk_qdma_pppq_show(struct seq_file *m, void *v)
 {
 	struct mtk_eth *eth = m->private;
+	const struct mtk_soc_data *soc = eth->soc;
 	struct net_device *pppq_map[MTK_QDMA_NUM_QUEUES] = { NULL };
+	bool is_ack_queue[MTK_QDMA_NUM_QUEUES] = { false };
 	struct net_device *ndev;
 	struct mtk_mac *mac;
-	int i;
+	char iface_name[32];
+	u32 pkt_cnt, drop_cnt, qtx_sch, max_rate, max_rate_exp;
+	int i, scheduler, weight;
 
 	mtk_eth_set_dsa_pppq_offset(eth);
 
@@ -114,56 +118,73 @@ static int mtk_qdma_pppq_show(struct seq
 				/* TCP ACK use high priority queue in HNAT */
 				qid += eth->pppq_ofs[MTK_MAX_DEVS];
 				pppq_map[qid % MTK_QDMA_NUM_QUEUES] = dp->user;
+				is_ack_queue[qid % MTK_QDMA_NUM_QUEUES] = true;
 			}
 		}
 	}
 
-	seq_puts(m, "Usage of the QDMA PPPQ for the HW path:\n");
+	seq_puts(m, "TXQ    Interface        Scheduler  Weight  Speed (Mbps)  Packets       Drops\n");
 	for (i = 0; i < MTK_QDMA_NUM_QUEUES; i++) {
-		if (pppq_map[i])
-			seq_printf(m, "qdma_txq%d:	%8s	%5d Mbps %8d refcnt\n",
-				   i, pppq_map[i]->name, eth->qdma_shaper.speed[i],
-				   atomic_read(&eth->qdma_shaper.refcnt[i]));
-	}
+		if (!pppq_map[i])
+			continue;
 
-	return 0;
-}
+		pkt_cnt = 0;
+		drop_cnt = 0;
 
-static int mtk_qdma_pppq_open(struct inode *inode, struct file *file)
-{
-	return single_open(file, mtk_qdma_pppq_show, inode->i_private);
-}
+		mtk_w32(eth, i / MTK_QTX_PER_PAGE, soc->reg_map->qdma.page);
+		qtx_sch = mtk_r32(eth, soc->reg_map->qdma.qtx_sch +
+				  (i % MTK_QTX_PER_PAGE) * MTK_QTX_OFFSET);
 
-static ssize_t mtk_qdma_pppq_write(struct file *file, const char __user *buffer,
-				   size_t count, loff_t *data)
-{
-	struct seq_file *m = (struct seq_file *)file->private_data;
-	struct mtk_eth *eth = m->private;
-	char buf[8] = {0};
-	u32 threshold;
-	int len = count;
+		if (mtk_is_netsys_v2_or_greater(eth))
+			scheduler = FIELD_GET(MTK_QTX_SCH_TX_SEL_V2, qtx_sch);
+		else
+			scheduler = FIELD_GET(MTK_QTX_SCH_TX_SEL, qtx_sch);
 
-	if ((len > 8) || copy_from_user(buf, buffer, len))
-		return -EFAULT;
+		weight = FIELD_GET(MTK_QTX_SCH_MAX_RATE_WEIGHT, qtx_sch);
+		max_rate = FIELD_GET(MTK_QTX_SCH_MAX_RATE_MAN, qtx_sch);
+		max_rate_exp = FIELD_GET(MTK_QTX_SCH_MAX_RATE_EXP, qtx_sch);
+		while (max_rate_exp--)
+			max_rate *= 10;
+
+		if (mtk_is_netsys_v2_or_greater(eth)) {
+			mtk_m32(eth, MTK_MIB_ON_QTX_CFG, MTK_MIB_ON_QTX_CFG,
+				soc->reg_map->qdma.qtx_mib_if);
+			mtk_m32(eth, MTK_VQTX_MIB_EN, MTK_VQTX_MIB_EN,
+				soc->reg_map->qdma.qtx_mib_if);
+			pkt_cnt = mtk_r32(eth, soc->reg_map->qdma.qtx_cfg +
+					  (i % MTK_QTX_PER_PAGE) * MTK_QTX_OFFSET);
+			drop_cnt = mtk_r32(eth, soc->reg_map->qdma.qtx_sch +
+					   (i % MTK_QTX_PER_PAGE) * MTK_QTX_OFFSET);
+			mtk_m32(eth, MTK_MIB_ON_QTX_CFG, 0,
+				soc->reg_map->qdma.qtx_mib_if);
+			mtk_m32(eth, MTK_VQTX_MIB_EN, 0,
+				soc->reg_map->qdma.qtx_mib_if);
+		}
 
-	if (sscanf(buf, "%6d", &threshold) != 1)
-		return -EFAULT;
+		if (is_ack_queue[i])
+			snprintf(iface_name, sizeof(iface_name), "%s (ack)",
+				 pppq_map[i]->name);
+		else
+			snprintf(iface_name, sizeof(iface_name), "%s",
+				 pppq_map[i]->name);
 
-	if (threshold > 10000 || threshold < 0) {
-		pr_warn("Threshold must be between 0 and 10000 Mbps\n");
-		return -EINVAL;
+		seq_printf(m, "%-5d  %-15s  %-9d  %-6d  %-12u  %-12u  %u\n",
+			   i, iface_name, scheduler, weight,
+			   max_rate / 1000, pkt_cnt, drop_cnt);
 	}
 
-	eth->qdma_shaper.threshold = threshold;
+	return 0;
+}
 
-	return len;
+static int mtk_qdma_pppq_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, mtk_qdma_pppq_show, inode->i_private);
 }
 
 static const struct file_operations mtk_eth_debugfs_qdma_pppq_fops = {
 	.owner = THIS_MODULE,
 	.open = mtk_qdma_pppq_open,
 	.read = seq_read,
-	.write = mtk_qdma_pppq_write,
 	.llseek = seq_lseek,
 	.release = single_release,
 };
@@ -898,9 +919,8 @@ int mtketh_debugfs_init(struct mtk_eth *
 				    &fops_mt7530sw_reg_w);
 	}
 
-	if (mtk_is_netsys_v3_or_greater(eth))
-		debugfs_create_file("qdma_pppq", 0444, eth_debug.root,
-				    eth, &mtk_eth_debugfs_qdma_pppq_fops);
+	debugfs_create_file("qdma_pppq", 0444, eth_debug.root,
+			    eth, &mtk_eth_debugfs_qdma_pppq_fops);
 
 	for (i = 0; i < (mtk_is_netsys_v2_or_greater(eth) ? 4 : 2); i++) {
 		ret = snprintf(name, sizeof(name), "qdma_sch%d", i);
