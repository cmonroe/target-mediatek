From: Cezary Wilmanski <cezary.wilmanski@adtran.com>
Date: Sun, 01 Feb 2026 19:35:59 +0100
Subject: [PATCH] leds: trigger: avoid deadlock when registering netdevice notifier

Registering the netdevice notifier directly from netdev_trig_activate()
may lead to a deadlock when the LED trigger is activated while the
networking core already holds the RTNL lock.

register_netdevice_notifier() acquires RTNL internally, and netdev LED
trigger activation can be invoked from contexts where RTNL is already
held (e.g. during netdevice registration or state changes), resulting
in a self-deadlock.

Fix this by deferring the notifier registration to a workqueue context.
A dedicated work_struct is introduced and scheduled from the activate
path, ensuring that register_netdevice_notifier() is executed outside
of the RTNL-protected context.

During trigger deactivation, pending registration work is cancelled
synchronously before unregistering the notifier, preventing races
between notifier registration and removal.

This change eliminates the deadlock scenario while preserving the
original behavior of the netdev LED trigger.

Signed-off-by: Cezary Wilmanski <cezary.wilmanski@adtran.com>
---
 drivers/leds/trigger/ledtrig-netdev.c |   25 +++++++++++++++++++-----
 1 file changed, 20 insertions(+), 5 deletions(-)

--- a/drivers/leds/trigger/ledtrig-netdev.c
+++ b/drivers/leds/trigger/ledtrig-netdev.c
@@ -58,6 +58,7 @@ struct led_netdev_data {
 	struct mutex lock;
 
 	struct delayed_work work;
+	struct work_struct register_work;
 	struct notifier_block notifier;
 
 	struct led_classdev *led_cdev;
@@ -682,6 +683,18 @@ static void netdev_trig_work(struct work
 			(atomic_read(&trigger_data->interval)*2));
 }
 
+static void netdev_trig_register_work(struct work_struct *work)
+{
+	struct led_netdev_data *td =
+		container_of(work, struct led_netdev_data, register_work);
+	int rc;
+
+	rc = register_netdevice_notifier(&td->notifier);
+	if (rc)
+		dev_warn(td->led_cdev->dev,
+			"Failed to register netdevice notifier: %d\n", rc);
+}
+
 static int netdev_trig_activate(struct led_classdev *led_cdev)
 {
 	struct led_netdev_data *trigger_data;
@@ -708,6 +721,8 @@ static int netdev_trig_activate(struct l
 	atomic_set(&trigger_data->interval, msecs_to_jiffies(NETDEV_LED_DEFAULT_INTERVAL));
 	trigger_data->last_activity = 0;
 
+	INIT_WORK(&trigger_data->register_work, netdev_trig_register_work);
+
 	/* Check if hw control is active by default on the LED.
 	 * Init already enabled mode in hw control.
 	 */
@@ -727,21 +742,21 @@ static int netdev_trig_activate(struct l
 
 	led_set_trigger_data(led_cdev, trigger_data);
 
-	rc = register_netdevice_notifier(&trigger_data->notifier);
-	if (rc)
-		kfree(trigger_data);
+	schedule_work(&trigger_data->register_work);
 
-	return rc;
+	return 0;
 }
 
 static void netdev_trig_deactivate(struct led_classdev *led_cdev)
 {
 	struct led_netdev_data *trigger_data = led_get_trigger_data(led_cdev);
 
-	unregister_netdevice_notifier(&trigger_data->notifier);
+	cancel_work_sync(&trigger_data->register_work);
 
 	cancel_delayed_work_sync(&trigger_data->work);
 
+	unregister_netdevice_notifier(&trigger_data->notifier);
+
 	dev_put(trigger_data->net_dev);
 
 	kfree(trigger_data);
