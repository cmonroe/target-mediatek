From: Chad Monroe <chad@monroe.io>
Date: Wed, 13 May 2026 12:00:00 -0800
Subject: [PATCH] net: ethernet: mediatek: lay out the PPPQ ACK half (offset and scheduler)

The TCP-ACK high-priority queue offset in mtk_flow_set_output_device()
was a literal "+ 6", which only stayed valid as long as the data range
fit in the first six queue slots. Layouts with more DSA user ports
collide:

  6-port DSA  (mt7988):  data 3..8,   +6  -> ack 9..14   ok by luck
  9-port DSA  (9000):    data 3..11,  +6  -> ack 9..17   COLLIDES
                                              (data q9..q11 = ack q0..q2)
  non-DSA 3-GMAC:        data 0..2,   +6  -> ack 6..8    ok by luck

Pick the offset per netsys generation instead, sized to the FOE QID
field width:

  netsys v1 (mt7621/mt7622, 4-bit MTK_FOE_IB2_QID, max qid 15):
    offset 6  - matches upstream MTK behaviour for mt7530-class
                5-port fabrics, the largest layout that fits the
                4-bit IB2 field on v1.

  netsys v2+ (mt7986/mt7987/mt7988, 7-bit MTK_FOE_IB2_QID_V2):
    offset MTK_QDMA_NUM_QUEUES / 2 = 16
                splits the qdma queue space cleanly in half. Data
                always lives in 0..15, ACK always lives in 16..31,
                independent of DSA / non-DSA / hybrid topology and
                of total user-port count (as long as data <= 15).

After this change:

  mt7622 5-port DSA:    data 3..7,   ack 9..13   (unchanged from "+6")
  mt7988 6-port DSA:    data 3..8,   ack 19..24  (moved up, no collision)
  9000 hybrid (10 DSA + wan): data 0..12, ack 16..28  (collision fixed)
  non-DSA 3-GMAC:       data 0..2,   ack 16..18  (clean partition)

Add a mtk_pppq_ack_queue_offset() helper so the offloader and the
qos_toggle log share a single source of truth.

Also align ACK qids onto the same QDMA scheduler as their data
partners. mtk_tx_alloc() pins GMAC1/2/3 base queues to sch0/1/2 at
boot; without this patch each ACK partner stays on sch0 by default
even when its data sibling is on sch1 or sch2, so ACK traffic for
GMAC2/3 misses the per-conduit scheduler bias.

  - mtk_tx_alloc(): when programming a queue's MTK_QTX_SCH register,
    also set TX_SEL_V2 for the GMAC2/3 ACK partners (qids
    MTK_GMAC{2,3}_ID + ack_offset) so they boot on sch1/sch2 alongside
    their data siblings.

  - mtk_device_event(): after the existing mtk_set_queue_speed() on
    NETDEV_CHANGE, bind both the per-port data queue and its ACK
    partner to the scheduler index that matches mac->id. This catches
    DSA user-port queues, whose qids are not known at probe time and
    therefore cannot be pinned by mtk_tx_alloc(). On the SDG-9000
    layout (dsa1 carries lan1..lan9), this moves all nine lan data
    queues and their ACK partners onto sch1, matching dsa1's conduit
    binding instead of the sch0 default.

  - new mtk_set_queue_sched() helper handles the per-queue TX_SEL_V2
    RMW. Restricted to netsys v2+, since v1 uses a different TX_SEL
    encoding and only owns a 4-bit FOE QID field.

Update the "PPPQ qid: ..." log line in the qos toggle handler to
reflect the active data range and ACK offset for the current
topology, and to drop the now-stale "(scheduler 0)" parenthetical.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c     |   44 +++++++++++++++++++++---
 drivers/net/ethernet/mediatek/mtk_eth_soc.h     |   22 ++++++++++++
 drivers/net/ethernet/mediatek/mtk_ppe_debugfs.c |    9 ++++
 drivers/net/ethernet/mediatek/mtk_ppe_offload.c |    6 +--
 4 files changed, 73 insertions(+), 8 deletions(-)

--- a/drivers/net/ethernet/mediatek/mtk_ppe_debugfs.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_debugfs.c
@@ -221,8 +221,15 @@ mtk_ppe_internal_debugfs_write_qos(struc
 		pr_info("HQoS mode is going to be enabled !\n");
 		eth->qos_toggle = 1;
 	} else if (buf[0] == '2') {
+		u32 ack_ofs = mtk_pppq_ack_queue_offset(eth);
+		u32 data_hi;
+
+		mtk_eth_set_dsa_pppq_offset(eth);
+		data_hi = MTK_MAX_DEVS - 1 + eth->pppq_ofs[MTK_MAX_DEVS];
+
 		pr_info("Per-port-per-queue mode is going to be enabled !\n");
-		pr_info("PPPQ use qid 3~14 (scheduler 0).\n");
+		pr_info("PPPQ qid: data 0~%u, ack at data+%u (per-conduit scheduler).\n",
+			data_hi, ack_ofs);
 		eth->qos_toggle = 2;
 	}
 
--- a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
@@ -340,11 +340,11 @@ mtk_flow_set_output_device(struct mtk_et
 
 	if (eth->qos_toggle == 2 && mtk_ppe_check_pppq_path(mac, idev, dsa_port)) {
 		if (ct && nf_ct_protonum(ct) == IPPROTO_TCP) {
-			/* Dispatch the IPv4/IPv6 TCP Ack packets to the high-priority
-			 * queue, assuming they are less than 64 bytes.
+			/* Dispatch IPv4/IPv6 TCP ACKs (<= 64 bytes) into the
+			 * high-priority half of the PPPQ range.
 			 */
 			if (mtk_flow_is_tcp_ack(eth, foe, ct))
-				queue += 6;
+				queue += mtk_pppq_ack_queue_offset(eth);
 		}
 		mtk_foe_entry_set_queue(eth, foe, queue & MTK_QDMA_QUEUE_MASK);
 	} else if (eth->qos_toggle == 1 || (ct_mark & MTK_QDMA_QUEUE_MASK) >= 15) {
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.h
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.h
@@ -28,6 +28,21 @@
 
 #define MTK_QDMA_NUM_QUEUES	32
 #define MTK_QDMA_QUEUE_MASK	((1ULL << MTK_QDMA_NUM_QUEUES) - 1)
+
+/* PPPQ TCP-ACK queue offset from the matching data queue.
+ *
+ * Netsys v1 FOE QID field is 4-bit (MTK_FOE_IB2_QID = GENMASK(3, 0)), so
+ * the ACK qid must fit in 0..15. Six matches the upstream MTK layout for
+ * mt7530-class 5-port fabrics.
+ *
+ * Netsys v2+ FOE QID field is 7-bit (MTK_FOE_IB2_QID_V2 = GENMASK(6, 0)),
+ * so there is room for any qid up to 127. Splitting MTK_QDMA_NUM_QUEUES
+ * in half gives a uniform data/ACK partition across DSA, non-DSA, and
+ * hybrid topologies with no collision as long as the data range stays
+ * below MTK_QDMA_NUM_QUEUES / 2.
+ */
+#define MTK_PPPQ_ACK_QUEUE_OFFSET_V1	6
+#define MTK_PPPQ_ACK_QUEUE_OFFSET_V2	(MTK_QDMA_NUM_QUEUES / 2)
 #define MTK_QDMA_PAGE_SIZE	2048
 #define MTK_MAX_RX_LENGTH	1536
 #define MTK_MAX_RX_LENGTH_2K	2048
@@ -1698,6 +1713,12 @@ static inline bool mtk_is_netsys_v3_or_g
 }
 #endif
 
+static inline u32 mtk_pppq_ack_queue_offset(struct mtk_eth *eth)
+{
+	return mtk_is_netsys_v1(eth) ? MTK_PPPQ_ACK_QUEUE_OFFSET_V1
+				     : MTK_PPPQ_ACK_QUEUE_OFFSET_V2;
+}
+
 static inline struct mtk_foe_entry *
 mtk_foe_get_entry(struct mtk_ppe *ppe, u16 hash)
 {
@@ -1841,5 +1862,6 @@ void mtk_eth_set_dma_device(struct mtk_e
 
 void mtk_eth_set_dsa_pppq_offset(struct mtk_eth *eth);
 void mtk_eth_set_dsa_user_idx(struct mtk_eth *eth, struct net_device *dev);
+void mtk_set_queue_sched(struct mtk_eth *eth, unsigned int idx, u32 sch_id);
 
 #endif /* MTK_ETH_H */
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -1003,6 +1003,25 @@ out:
 	mtk_w32(eth, val, soc->reg_map->qdma.qtx_sch + ofs);
 }
 
+void mtk_set_queue_sched(struct mtk_eth *eth, unsigned int idx, u32 sch_id)
+{
+	const struct mtk_soc_data *soc = eth->soc;
+	u32 ofs, val;
+
+	if (!MTK_HAS_CAPS(soc->caps, MTK_QDMA) ||
+	    !mtk_is_netsys_v2_or_greater(eth))
+		return;
+
+	mtk_w32(eth, (idx / MTK_QTX_PER_PAGE), soc->reg_map->qdma.page);
+	ofs = MTK_QTX_OFFSET * (idx % MTK_QTX_PER_PAGE);
+	val = mtk_r32(eth, soc->reg_map->qdma.qtx_sch + ofs);
+
+	val &= ~MTK_QTX_SCH_TX_SEL_V2;
+	val |= FIELD_PREP(MTK_QTX_SCH_TX_SEL_V2, sch_id);
+
+	mtk_w32(eth, val, soc->reg_map->qdma.qtx_sch + ofs);
+}
+
 static void mtk_gdm_mac_setup_eee(struct mtk_mac *mac, bool enable)
 {
 	struct mtk_eth *eth = mac->hw;
@@ -3080,10 +3099,15 @@ static int mtk_tx_alloc(struct mtk_eth *
 			if (mtk_is_netsys_v1(eth))
 				val |= MTK_QTX_SCH_LEAKY_BUCKET_EN;
 
-			if (mtk_is_netsys_v2_or_greater(eth) && i == MTK_GMAC2_ID)
-				val |= FIELD_PREP(MTK_QTX_SCH_TX_SEL_V2, 1);
-			else if (mtk_is_netsys_v3_or_greater(eth) && i == MTK_GMAC3_ID)
-				val |= FIELD_PREP(MTK_QTX_SCH_TX_SEL_V2, 2);
+			if (mtk_is_netsys_v2_or_greater(eth)) {
+				u32 ack_ofs = mtk_pppq_ack_queue_offset(eth);
+
+				if (i == MTK_GMAC2_ID || i == MTK_GMAC2_ID + ack_ofs)
+					val |= FIELD_PREP(MTK_QTX_SCH_TX_SEL_V2, 1);
+				else if (mtk_is_netsys_v3_or_greater(eth) &&
+					 (i == MTK_GMAC3_ID || i == MTK_GMAC3_ID + ack_ofs))
+					val |= FIELD_PREP(MTK_QTX_SCH_TX_SEL_V2, 2);
+			}
 
 			mtk_w32(eth, val, soc->reg_map->qdma.qtx_sch + ofs);
 			ofs = (ofs + MTK_QTX_OFFSET) % (MTK_QTX_OFFSET * MTK_QTX_PER_PAGE);
@@ -4214,6 +4238,18 @@ found:
 
 	mtk_set_queue_speed(eth, queue, s.base.speed);
 
+	/* Bind each PPPQ queue and its ACK partner to the scheduler
+	 * tied to its conduit GMAC (mac->id), so DSA user-port traffic
+	 * shares its conduit's scheduler instead of defaulting to sch0.
+	 */
+	if (mtk_is_netsys_v2_or_greater(eth)) {
+		u32 ack_queue = queue + mtk_pppq_ack_queue_offset(eth);
+
+		mtk_set_queue_sched(eth, queue, mac->id);
+		if (ack_queue < MTK_QDMA_NUM_QUEUES)
+			mtk_set_queue_sched(eth, ack_queue, mac->id);
+	}
+
 	return NOTIFY_DONE;
 }
 
