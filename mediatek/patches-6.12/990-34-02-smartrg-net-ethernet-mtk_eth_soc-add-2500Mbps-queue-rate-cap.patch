From: Chad Monroe <chad@monroe.io>
Date: Fri, 15 May 2026 13:40:33 -0700
Subject: [PATCH] net: ethernet: mtk_eth_soc: add 2500 Mbps queue rate cap

Netsys v3 widened MTK_QTX_SCH_MAX_RATE_{MAN,EXP}_V3 to encode rates above
1 Gbps. Add a SPEED_2500 case for v3 (and the MT7988 v1/v2-layout
exception) and short-circuit speed > SPEED_1000 on pre-v3 silicon so the
unsupported encoding never reaches the register.

Based-on-patch-by: Bo-Cun Chen <bc-bocun.chen@mediatek.com>
Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c |   16 ++++++++++++++++
 1 file changed, 16 insertions(+)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -844,6 +844,9 @@ static void mtk_set_queue_speed(struct m
 	if (mtk_is_netsys_v1(eth))
 		val |= MTK_QTX_SCH_LEAKY_BUCKET_EN;
 
+	if (!mtk_is_netsys_v3_or_greater(eth) && speed > SPEED_1000)
+		goto out;
+
 	if (IS_ENABLED(CONFIG_SOC_MT7621)) {
 		switch (speed) {
 		case SPEED_10:
@@ -867,8 +870,7 @@ static void mtk_set_queue_speed(struct m
 		default:
 			break;
 		}
-	} else if (mtk_is_netsys_v3_or_greater(eth) &&
-		   (eth->soc->caps != MT7988_CAPS)) {
+	} else if (mtk_qtx_sch_is_v3_layout(eth)) {
 		switch (speed) {
 		case SPEED_10:
 			val |= MTK_QTX_SCH_MAX_RATE_EN_V3 |
@@ -911,11 +913,18 @@ static void mtk_set_queue_speed(struct m
 			       FIELD_PREP(MTK_QTX_SCH_MAX_RATE_EXP, 6) |
 			       FIELD_PREP(MTK_QTX_SCH_MAX_RATE_WEIGHT, 10);
 			break;
+		case SPEED_2500:
+			val |= MTK_QTX_SCH_MAX_RATE_EN |
+			       FIELD_PREP(MTK_QTX_SCH_MAX_RATE_MAN, 25) |
+			       FIELD_PREP(MTK_QTX_SCH_MAX_RATE_EXP, 5) |
+			       FIELD_PREP(MTK_QTX_SCH_MAX_RATE_WEIGHT, 10);
+			break;
 		default:
 			break;
 		}
 	}
 
+out:
 	mtk_qdma_select_page(eth, idx);
 	mtk_w32(eth, val, soc->reg_map->qdma.qtx_sch + MTK_QTX_REG_OFS(idx));
 }
