From: Chad Monroe <chad@monroe.io>
Date: Tue, 12 Aug 2025 20:22:59 -0700
Subject: [PATCH] net: phy: as21xxx: add hwmon support 

add support for reading PHY IC temperature

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/phy/as21xxx.c |  111 +++++++++++++++++++++++++++++++++++-
 1 file changed, 108 insertions(+), 3 deletions(-)

--- a/drivers/net/phy/as21xxx.c
+++ b/drivers/net/phy/as21xxx.c
@@ -8,6 +8,7 @@
 #include <linux/bitfield.h>
 #include <linux/firmware.h>
 #include <linux/module.h>
+#include <linux/hwmon.h>
 #include <linux/of.h>
 #include <linux/phy.h>
 
@@ -108,11 +109,14 @@
 #define IPC_CFG_PARAM_DIRECT_DPC_PKT_CHK 0x7
 #define IPC_CFG_PARAM_DIRECT_DPC_SDS_WAIT_ETH 0x8
 #define IPC_CFG_PARAM_DIRECT_WDT	0x9
-#define IPC_CFG_PARAM_DIRECT_SDS_RESTART_AN 0x10
-#define IPC_CFG_PARAM_DIRECT_TEMP_MON	0x11
-#define IPC_CFG_PARAM_DIRECT_WOL	0x12
+#define IPC_CFG_PARAM_DIRECT_SDS_RESTART_AN 0xa
+#define IPC_CFG_PARAM_DIRECT_TEMP_MON	0xb
+#define IPC_CFG_PARAM_DIRECT_WOL	0xc
 
 /* Sub command of CMD_TEMP_MON */
+#define IPC_CMD_TEMP_MON_START		0x1
+#define IPC_CMD_TEMP_MON_STOP		0x2
+#define IPC_CMD_TEMP_MON_SET_CFG	0x3
 #define IPC_CMD_TEMP_MON_GET		0x4
 
 #define AS21XXX_MDIO_AN_C22		0xffe0
@@ -600,6 +604,103 @@ static int aeon_dpc_ra_enable(struct phy
 				 sizeof(data), NULL);
 }
 
+#if IS_ENABLED(CONFIG_HWMON)
+static int aeon_hwmon_read(struct device *dev,
+			  enum hwmon_sensor_types type,
+			  u32 attr, int channel, long *value)
+{
+	struct phy_device *phydev = dev_get_drvdata(dev);
+	u16 ret_data[AEON_IPC_DATA_NUM_REGISTERS], data[4], tmp;
+	u32 params;
+	int ret;
+
+	/* read temperature */
+	data[0] = IPC_CFG_PARAM_DIRECT;
+	data[1] = IPC_CFG_PARAM_DIRECT_TEMP_MON;
+	data[2] = IPC_CMD_TEMP_MON_GET;
+	data[3] = 0;
+	ret = aeon_ipc_send_msg(phydev, IPC_CMD_CFG_PARAM, data,
+				sizeof(data), ret_data);
+	if (ret < 0)
+		return ret;
+
+	params = (u32)(ret_data[1] | (ret_data[2] << 16));
+	tmp = params / 65536;
+	if (tmp > 32768)
+		tmp = tmp - 1 - 0xFFFF;
+
+	*value = (tmp * 1000);
+	return 0;
+}
+
+static umode_t aeon_hwmon_is_visible(const void *data,
+				    enum hwmon_sensor_types type,
+				    u32 attr, int channel)
+{
+	return 0444;
+}
+
+static const struct hwmon_channel_info * const aeon_hwmon_info[] = {
+	HWMON_CHANNEL_INFO(temp, HWMON_T_INPUT),
+	NULL
+};
+
+static const struct hwmon_ops aeon_hwmon_hwmon_ops = {
+	.is_visible	= aeon_hwmon_is_visible,
+	.read		= aeon_hwmon_read,
+};
+
+static const struct hwmon_chip_info aeon_hwmon_chip_info = {
+	.ops		= &aeon_hwmon_hwmon_ops,
+	.info		= aeon_hwmon_info,
+};
+
+static int aeon_hwmon_register(struct phy_device *phydev)
+{
+	struct device *dev = &phydev->mdio.dev;
+	struct device *hwmon_dev;
+	char *hwmon_name;
+	u16 data[4];
+	int ret;
+
+	hwmon_name = devm_hwmon_sanitize_name(dev, dev_name(dev));
+	if (IS_ERR(hwmon_name))
+		return PTR_ERR(hwmon_name);
+
+	hwmon_dev = devm_hwmon_device_register_with_info(dev, hwmon_name, phydev,
+ 							 &aeon_hwmon_chip_info, NULL);
+	if (IS_ERR(hwmon_dev))
+		return PTR_ERR_OR_ZERO(hwmon_dev);
+
+	/* set continuous temperature sampling */
+	data[0] = IPC_CFG_PARAM_DIRECT;
+	data[1] = IPC_CFG_PARAM_DIRECT_TEMP_MON;
+	data[2] = IPC_CMD_TEMP_MON_SET_CFG;
+	data[3] = 1;
+	ret = aeon_ipc_send_msg(phydev, IPC_CMD_CFG_PARAM, data,
+				sizeof(data), NULL);
+	if (ret < 0)
+		return ret;
+
+	/* start temperature monitoring */
+	data[0] = IPC_CFG_PARAM_DIRECT;
+	data[1] = IPC_CFG_PARAM_DIRECT_TEMP_MON;
+	data[2] = IPC_CMD_TEMP_MON_START;
+	data[3] = 0;
+	ret = aeon_ipc_send_msg(phydev, IPC_CMD_CFG_PARAM, data,
+				sizeof(data), NULL);
+	if (ret < 0)
+		return ret;
+
+	return 0;
+}
+#else
+static int aeon_hwmon_register(struct phy_device *phydev)
+{
+	return 0;
+}
+#endif
+
 static int as21xxx_probe(struct phy_device *phydev)
 {
 	struct as21xxx_priv *priv;
@@ -637,6 +738,10 @@ static int as21xxx_probe(struct phy_devi
 	if (ret)
 		return ret;
 
+	ret = aeon_hwmon_register(phydev);
+	if (ret)
+		return ret;
+
 	return aeon_dpc_ra_enable(phydev);
 }
 
