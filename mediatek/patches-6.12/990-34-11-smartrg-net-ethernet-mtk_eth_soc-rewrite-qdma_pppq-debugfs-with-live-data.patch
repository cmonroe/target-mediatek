+		max_rate_exp = FIELD_GET(MTK_QTX_SCH_MAX_RATE_EXP, qtx_sch);
+	}
 
 	while (min_rate_exp--)
 		min_rate *= 10;
@@ -387,13 +510,23 @@ static ssize_t qdma_queue_write(struct f
 
 	if (min_enable)
 		qtx_sch |= MTK_QTX_SCH_MIN_RATE_EN;
