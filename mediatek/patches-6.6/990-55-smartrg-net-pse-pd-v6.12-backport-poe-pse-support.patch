diff --git a/include/linux/pse-pd/pse.h b/include/linux/pse-pd/pse.h
index 15a36911e57f..0b07db198f13 100644
--- a/include/linux/pse-pd/pse.h
+++ b/include/linux/pse-pd/pse.h
@@ -77,6 +77,7 @@ struct pse_control;
