+	s->multicast += v;
+	s->tx_packets += v;
+}
+
+static inline void mt7530_update_rx_multicast(struct rtnl_link_stats64 *s, u64 v)
+{
+	s->multicast += v;
+	s->rx_packets += v;
+}
