+static void
+mt7530_mib_fetch_port_stat(struct mt7530_priv *priv, int port)
+{
+	const u32 base_reg = MT7530_PORT_MIB_COUNTER(port);
+	struct rtnl_link_stats64 *storage = &priv->stats[port];
+	u32 i;
+
+	memset(storage, 0, sizeof(*storage));
+
+	for (i = 0; i < ARRAY_SIZE(mt7530_mib); i++) {
+		const struct mt7530_mib_desc *mib = &mt7530_mib[i];
+		u64 val;
+
+		/* skip counters with no link_stats mapping */
+		if (!mib->stats)
+			continue;
+
+		val = mt7530_read(priv, base_reg + mib->offset);
+		if (mib->size == 2) {
+			u64 hi = mt7530_read(priv, base_reg + mib->offset + 4);
+			val |= hi << 32;
+		}
+
+		mib->stats(storage, val);
+	}
+}
+
+static void
+mt7530_mib_work_func(struct work_struct *work)
+{
+	struct mt7530_priv *priv;
+	int port;
+
+	priv = container_of(work, struct mt7530_priv, mib_work.work);
+
+	mutex_lock(&priv->mib_lock);
+
+	for (port = 0; port < MT7530_NUM_PORTS; port++)
+		mt7530_mib_fetch_port_stat(priv, port);
+
+	mutex_unlock(&priv->mib_lock);
+
+	schedule_delayed_work(&priv->mib_work,
+			      msecs_to_jiffies(MT7530_MIB_WORK_DELAY));
+}
+
+void mt7530_get_stats64(struct dsa_switch *ds, int port,
+			struct rtnl_link_stats64 *stats)
+{
+	struct mt7530_priv *priv = ds->priv;
+
+	if (!stats) {
+		dev_err(ds->dev, "NULL stats64 pointer\n");
+		return;
+	}
+
+	mutex_lock(&priv->mib_lock);
+	memcpy(stats, &priv->stats[port], sizeof(struct rtnl_link_stats64));
+	mutex_unlock(&priv->mib_lock);
+
+	if (!priv->mib_work_started) {
+		priv->mib_work_started = true;
+		schedule_delayed_work(&priv->mib_work, 0);
+	}
+}
