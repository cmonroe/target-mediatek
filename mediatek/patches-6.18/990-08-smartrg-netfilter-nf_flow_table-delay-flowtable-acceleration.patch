From: Chad Monroe <chad@monroe.io>
Date: Sun, 18 Jan 2026 19:21:14 -0800
Subject: [PATCH] netfilter: nf_flow_table: delay flowtable acceleration

Delay flowtable acceleration (both software and hardware) until sufficient
traffic has been observed. This allows packet inspection tools to analyze
early flow packets before they are accelerated.

Threshold is configurable via nf_flow_table.offload_delay_per_dir
module parameter/sysfs (default 5 packets per direction, 0 disables).

Non-TCP flows only require the threshold in a single direction
since they may be unidirectional.

Directions that can never match in the software fast-path hook are
pre-qualified so offload is not blocked waiting for packets that
cannot be counted: directions with VLAN encaps (the tag is stripped
before the netfilter hook) and directions whose forward path does
not resolve to a flowtable device (e.g. wifi paths terminating in
DEV_PATH_MTK_WDMA, which keep the L3 device iifidx). Packets of a
pre-qualified direction continue through the slow path until the
flow is accelerated, so inspection tools still see them.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 include/net/netfilter/nf_flow_table.h |   11 ++++
 net/netfilter/nf_flow_table_core.c    |   78 +++++++++++++++++++++++++++++++---
 net/netfilter/nf_flow_table_ip.c      |   18 +++++--
 net/netfilter/nft_flow_offload.c      |    6 ++
 4 files changed, 100 insertions(+), 13 deletions(-)

--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -1,6 +1,7 @@
 #ifndef _NF_FLOW_TABLE_H
 #define _NF_FLOW_TABLE_H
 
+#include <linux/atomic.h>
 #include <linux/in.h>
 #include <linux/in6.h>
 #include <linux/netdevice.h>
@@ -18,6 +19,8 @@ struct nf_flow_rule;
 struct flow_offload;
 enum flow_offload_tuple_dir;
 
+extern unsigned int nf_flowtable_offload_delay_per_dir;
+
 struct nf_flow_key {
 	struct flow_dissector_key_meta			meta;
 	struct flow_dissector_key_control		control;
@@ -192,6 +195,7 @@ struct flow_offload {
 	struct flow_offload_tuple_rhash		tuplehash[FLOW_OFFLOAD_DIR_MAX];
 	struct nf_conn				*ct;
 	unsigned long				flags;
+	atomic_t				slowpath_pkts[FLOW_OFFLOAD_DIR_MAX];
 	u16					type;
 	u32					timeout;
 	struct rcu_head				rcu_head;
@@ -202,6 +206,10 @@ struct flow_offload {
 
 unsigned long flow_offload_get_timeout(struct flow_offload *flow);
 
+bool nf_flow_offload_ready(struct nf_flowtable *flow_table,
+			   struct flow_offload *flow,
+			   enum flow_offload_tuple_dir dir);
+
 static inline __s32 nf_flow_timeout_delta(unsigned int timeout)
 {
 	return (__s32)(timeout - nf_flowtable_time_stamp);
@@ -219,7 +227,8 @@ struct nf_flow_route {
 				__be16		proto;
 			} encap[NF_FLOW_TABLE_ENCAP_MAX];
 			u8			num_encaps:2,
-						ingress_vlans:2;
+						ingress_vlans:2,
+						unmatchable:1;
 		} in;
 		struct {
 			u32			ifindex;
--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -17,6 +17,11 @@
 #include <net/switchdev.h>
 #endif
 
+unsigned int nf_flowtable_offload_delay_per_dir __read_mostly = 5;
+module_param_named(offload_delay_per_dir, nf_flowtable_offload_delay_per_dir, uint, 0644);
+MODULE_PARM_DESC(offload_delay_per_dir,
+		 "Packets per direction before enabling flowtable acceleration (0 disables delay)");
+
 static DEFINE_MUTEX(flowtable_lock);
 static LIST_HEAD(flowtables);
 
@@ -168,9 +173,32 @@ static void nft_flow_dst_release(struct
 void flow_offload_route_init(struct flow_offload *flow,
 			     struct nf_flow_route *route)
 {
+	int dir;
+
 	flow_offload_fill_route(flow, route, FLOW_OFFLOAD_DIR_ORIGINAL);
 	flow_offload_fill_route(flow, route, FLOW_OFFLOAD_DIR_REPLY);
 	flow->type = NF_FLOW_OFFLOAD_ROUTE;
+
+	/* Pre-qualify directions whose tuple can never match in the SW
+	 * fast-path hook, so that the per-dir threshold is already
+	 * satisfied and offload is not blocked waiting for SW matches
+	 * that will never arrive:
+	 *
+	 * - VLAN encaps are stored in the tuple hash key but can only
+	 *   be populated when the tag is still in the skb at hook time.
+	 *   Both bridge HW-untag (in_vlan_ingress) and standalone VLAN
+	 *   sub-interfaces strip the tag before the netfilter hook.
+	 *
+	 * - Directions whose forward path did not resolve to a flowtable
+	 *   device (e.g. wifi paths terminating in DEV_PATH_MTK_WDMA)
+	 *   keep the L3 device iifidx, which the per-device ingress
+	 *   hooks never present. */
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		if (flow->tuplehash[dir].tuple.encap_num ||
+		    route->tuple[dir].in.unmatchable)
+			atomic_set(&flow->slowpath_pkts[dir],
+				   READ_ONCE(nf_flowtable_offload_delay_per_dir));
+	}
 }
 EXPORT_SYMBOL_GPL(flow_offload_route_init);
 
@@ -329,6 +357,48 @@ unsigned long flow_offload_get_timeout(s
 	return timeout;
 }
 
+bool nf_flow_offload_ready(struct nf_flowtable *flow_table,
+			   struct flow_offload *flow,
+			   enum flow_offload_tuple_dir dir)
+{
+	unsigned int threshold;
+	atomic_t *cnt;
+	int old;
+
+	threshold = READ_ONCE(nf_flowtable_offload_delay_per_dir);
+	if (!threshold)
+		goto ready;
+
+	cnt = &flow->slowpath_pkts[dir];
+	for (;;) {
+		old = atomic_read(cnt);
+		if (old >= threshold)
+			break;
+
+		if (atomic_cmpxchg(cnt, old, old + 1) == old)
+			break;
+	}
+
+	if (atomic_read(cnt) < threshold)
+		goto not_ready;
+
+	if (nf_ct_protonum(flow->ct) == IPPROTO_TCP &&
+	    atomic_read(&flow->slowpath_pkts[!dir]) < threshold)
+		goto not_ready;
+
+ready:
+	if (nf_flowtable_hw_offload(flow_table) &&
+	    !test_and_set_bit(NF_FLOW_HW, &flow->flags))
+		nf_flow_offload_add(flow_table, flow);
+
+	return true;
+
+not_ready:
+	flow_offload_refresh(flow_table, flow, false);
+	return false;
+}
+EXPORT_SYMBOL_GPL(nf_flow_offload_ready);
+
 int flow_offload_add(struct nf_flowtable *flow_table, struct flow_offload *flow)
 {
 	int err;
@@ -359,11 +429,6 @@ int flow_offload_add(struct nf_flowtable
 		atomic_inc(&flow_table->direct_xmit_count);
 #endif
 
-	if (nf_flowtable_hw_offload(flow_table)) {
-		__set_bit(NF_FLOW_HW, &flow->flags);
-		nf_flow_offload_add(flow_table, flow);
-	}
-
 	return 0;
 }
 EXPORT_SYMBOL_GPL(flow_offload_add);
@@ -383,6 +448,9 @@ void flow_offload_refresh(struct nf_flow
 	    test_bit(NF_FLOW_CLOSING, &flow->flags))
 		return;
 
+	if (!test_bit(NF_FLOW_HW, &flow->flags))
+		return;
+
 	nf_flow_offload_add(flow_table, flow);
 }
 EXPORT_SYMBOL_GPL(flow_offload_refresh);
--- a/net/netfilter/nf_flow_table_ip.c
+++ b/net/netfilter/nf_flow_table_ip.c
@@ -434,6 +434,12 @@ nf_flow_offload_ip_hook(void *priv, stru
 	if (!tuplehash)
 		return NF_ACCEPT;
 
+	dir = tuplehash->tuple.dir;
+	flow = container_of(tuplehash, struct flow_offload, tuplehash[dir]);
+
+	if (!nf_flow_offload_ready(flow_table, flow, dir))
+		return NF_ACCEPT;
+
 	ret = nf_flow_offload_forward(&ctx, flow_table, tuplehash, skb);
 	if (ret < 0)
 		return NF_DROP;
@@ -448,9 +454,6 @@ nf_flow_offload_ip_hook(void *priv, stru
 		return nf_flow_xmit_xfrm(skb, state, &rt->dst);
 	}
 
-	dir = tuplehash->tuple.dir;
-	flow = container_of(tuplehash, struct flow_offload, tuplehash[dir]);
-
 	switch (tuplehash->tuple.xmit_type) {
 	case FLOW_OFFLOAD_XMIT_NEIGH:
 		rt = dst_rtable(tuplehash->tuple.dst_cache);
@@ -729,6 +732,12 @@ nf_flow_offload_ipv6_hook(void *priv, st
 	if (tuplehash == NULL)
 		return NF_ACCEPT;
 
+	dir = tuplehash->tuple.dir;
+	flow = container_of(tuplehash, struct flow_offload, tuplehash[dir]);
+
+	if (!nf_flow_offload_ready(flow_table, flow, dir))
+		return NF_ACCEPT;
+
 	ret = nf_flow_offload_ipv6_forward(&ctx, flow_table, tuplehash, skb);
 	if (ret < 0)
 		return NF_DROP;
@@ -743,9 +752,6 @@ nf_flow_offload_ipv6_hook(void *priv, st
 		return nf_flow_xmit_xfrm(skb, state, &rt->dst);
 	}
 
-	dir = tuplehash->tuple.dir;
-	flow = container_of(tuplehash, struct flow_offload, tuplehash[dir]);
-
 	switch (tuplehash->tuple.xmit_type) {
 	case FLOW_OFFLOAD_XMIT_NEIGH:
 		rt = dst_rt6_info(tuplehash->tuple.dst_cache);
--- a/net/netfilter/nft_flow_offload.c
+++ b/net/netfilter/nft_flow_offload.c
@@ -207,8 +207,12 @@ static void nft_dev_forward_path(struct
 	if (nft_dev_fill_forward_path(route, dst, ct, dir, ha, &stack) >= 0)
 		nft_dev_path_info(&stack, &info, ha, &ft->data);
 
-	if (!info.indev || !nft_flowtable_find_dev(info.indev, ft))
+	if (!info.indev || !nft_flowtable_find_dev(info.indev, ft)) {
+		/* The ingress hooks run on the flowtable devices, so tuples
+		 * left at the L3 device iifidx can never match there. */
+		route->tuple[!dir].in.unmatchable = 1;
 		return;
+	}
 
 	route->tuple[!dir].in.ifindex = info.indev->ifindex;
 	for (i = 0; i < info.num_encaps; i++) {
