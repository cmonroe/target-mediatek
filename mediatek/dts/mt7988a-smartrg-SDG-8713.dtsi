/*
 * Copyright (C) 2025 SmartRG Inc.
 * Author: Chad Monroe <chad.monroe@smartrg.com>
 *
 * Mt. Stuart phase 4: dual Realtek RTL8261 10G PHYs, MT7992 radio on
 * pcie1, built-in switch as lan2..lan4. Shared by SDG-8713 and
 * SDG-8713v; the voice variant adds the SLIC on top.
 */

#include "mt7988-smartrg-base.dtsi"
#include "mt7988-smartrg-sysled.dtsi"
#include "mt7988a-smartrg-mt-stuart-gsw.dtsi"

/ {
	aliases {
		label-mac-device = &gmac1;
	};

	chosen {
		linux,usable-memory-range = <0x0 0x40000000 0x0 0x3fc00000>;
	};

	gpio-keys {
		button-sync {
			label = "sync";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pio 14 GPIO_ACTIVE_LOW>;
		};
	};

	/* ballast: exports for unused BT/GPS/SLIC/USB, carried from pre-refactor dtb */
	gpio-export {
		compatible = "gpio-export";

		bluetooth_reset {
			gpio-export,name = "bt_reset";
			gpio-export,direction_may_change;
			gpios = <&pio 20 GPIO_ACTIVE_HIGH>;
		};

		bluetooth_txrx_ctl {
			gpio-export,name = "bt_txrx_ctl";
			gpio-export,direction_may_change;
			gpios = <&pio 74 GPIO_ACTIVE_HIGH>;
		};

		gps_enable {
			gpio-export,name = "gps_enable";
			gpio-export,output = <1>;
			gpios = <&pio 9 GPIO_ACTIVE_LOW>;
		};

		slic_interrupt {
			gpio-export,name = "slic_interrupt";
			gpio-export,direction_may_change;
			gpios = <&pio 54 GPIO_ACTIVE_HIGH>;
		};

		slic_reset {
			gpio-export,name = "slic_reset";
			gpio-export,output = <0>;
			gpios = <&pio 72 GPIO_ACTIVE_HIGH>;
		};

		usb_enable {
			gpio-export,name = "usb_enable";
			gpio-export,output = <1>;
			gpios = <&pio 63 GPIO_ACTIVE_HIGH>;
		};
	};
};

&button_pins {
	pins = "GPIO_RESET", "GPIO_WPS";
};

&gmac1 {
	nvmem-cells = <&macaddr 0x0>;
	nvmem-cell-names = "mac-address";
	label = "lan1";
	phy-mode = "usxgmii";
	phy = <&phy1>;

	status = "okay";
};

&gmac2 {
	nvmem-cells = <&macaddr 0x1>;
	nvmem-cell-names = "mac-address";
	label = "wan";
	phy-mode = "usxgmii";
	phy = <&phy2>;

	status = "okay";
};

&mdio_bus {
	phy1: ethernet-phy@1 {
		/* Realtek RTL8261 - LAN1 */
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <1>;
		#thermal-sensor-cells = <0>;

		reset-gpios = <&pio 62 GPIO_ACTIVE_LOW>;
		reset-assert-us = <100000>;
		reset-deassert-us = <221000>;

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_WHITE>;
				function = LED_FUNCTION_LAN;
				function-enumerator = <1>;
			};

			led@1 {
				reg = <1>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_LAN;
				function-enumerator = <1>;
				active-low;
			};

			led@3 {
				reg = <3>;
				color = <LED_COLOR_ID_ORANGE>;
				function = LED_FUNCTION_LAN;
				function-enumerator = <1>;
				active-low;
			};
		};
	};

	phy2: ethernet-phy@2 {
		/* Realtek RTL8261 - WAN */
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <2>;
		#thermal-sensor-cells = <0>;

		reset-gpios = <&pio 71 GPIO_ACTIVE_LOW>;
		reset-assert-us = <100000>;
		reset-deassert-us = <221000>;

		leds {
			#address-cells = <1>;
			#size-cells = <0>;

			led@0 {
				reg = <0>;
				color = <LED_COLOR_ID_WHITE>;
				function = LED_FUNCTION_WAN;
				active-low;
			};

			led@1 {
				reg = <1>;
				color = <LED_COLOR_ID_ORANGE>;
				function = LED_FUNCTION_WAN;
			};

			led@3 {
				reg = <3>;
				color = <LED_COLOR_ID_GREEN>;
				function = LED_FUNCTION_WAN;
			};
		};
	};
};

&emmc_block {
	partitions {
		block-partition-factory {
			partname = "factory";

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				eeprom_factory_0: eeprom@0 {
					reg = <0x0 0x1e00>;
				};

				/* mt7992 precal data size */
				precal_factory_1e10: precal@1e10 {
					reg = <0x1e10 0x8b038>;
				};
			};
		};

		block-partition-mfginfo {
			partname = "mfginfo";

			nvmem-layout {
				compatible = "adtran,mfginfo";

				macaddr: mfg-mac {
					#nvmem-cell-cells = <1>;
				};
			};
		};
	};
};

/* ballast: pinctrl and wifi reset on a disabled port, carried from pre-refactor dtb */
&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_1_pins>;
	wifi-reset-gpios = <&pio 7 GPIO_ACTIVE_LOW>;
	wifi-reset-msleep = <100>;
	wifi-deassert-msleep = <500>;
	status = "disabled";

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
	};
};

&pcie1 {
	wifi-reset-gpios = <&pio 7 GPIO_ACTIVE_LOW>;
	wifi-reset-msleep = <100>;
	wifi-deassert-msleep = <500>;
	status = "okay";

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;

		radio0: mt7996@0,0 {
			reg = <0x0000 0 0 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			nvmem-cells = <&eeprom_factory_0>, <&precal_factory_1e10>;
			nvmem-cell-names = "eeprom", "precal";
			ieee80211-freq-limit = <2400000 2500000>, <5170000 5835000>;

			band@0 {
				/* 2.4 GHz */
				reg = <0>;
				nvmem-cells = <&macaddr 0x4>;
				nvmem-cell-names = "mac-address";
			};

			band@1 {
				/* 5 GHz */
				reg = <1>;
				nvmem-cells = <&macaddr 0xa>;
				nvmem-cell-names = "mac-address";
			};
		};
	};
};

&pio {
	/* ballast: unused pin groups, carried from pre-refactor dtb */
	pcie0_1_pins: pcie0-pins-g1 {
		mux {
			function = "pcie";
			groups = "pcie_2l_0_pereset", "pcie_clk_req_n0_0";
		};
	};

	pwm_pins: pwm-pins {
		mux {
			function = "pwm";
			groups = "pwm0", "pwm1";
		};
	};

	sfp_i2c_pins: sfp-i2c-pins {
		conf-scl {
			pins = "LED_A";
			drive-strength =  <MTK_DRIVE_8mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
		conf-sda {
			pins = "LED_E";
			drive-strength =  <MTK_DRIVE_8mA>;
			bias-disable;
		};
	};

	uart1_pins: uart1-pins {
		mux {
			function = "uart";
			groups = "uart1_2";
		};
	};

	uart2_pins: uart2-pins {
		mux {
			function = "uart";
			groups = "uart2";
		};
	};
};

/* ballast: pwm enabled with no consumer, carried from pre-refactor dtb */
&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_pins>;
	status = "okay";
};

/* ballast: pinctrl on disabled uarts, carried from pre-refactor dtb */
&serial1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>;
	status = "disabled";
};

&serial2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2_pins>;
	status = "disabled";
};

/* ballast: u3p mask on a disabled controller, carried from pre-refactor dtb */
&ssusb1 {
	mediatek,u3p-dis-msk = <0x1>;
};
