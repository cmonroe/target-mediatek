#include "mt7988d-smartrg-mt-stuart-phase2.dtsi"
#include "mt7988d-smartrg-SDG-9732i-power-limits-r1-RCM-AU-NZ.dtsi"
#include "mt7988d-smartrg-SDG-9732i-power-limits-r2-IC-CA.dtsi"
#include "mt7988d-smartrg-SDG-9732i-power-limits-r3-ETSI-GB.dtsi"
#include "mt7988d-smartrg-SDG-9732i-power-limits-r4-ETSI.dtsi"
#include "mt7988d-smartrg-SDG-9732i-power-limits-r5-FCC-US.dtsi"

/ {
	model = "SmartRG SDG-9732i";
	compatible = "smartrg,sdg-9732i", "mediatek,mt7988a";
};

&radio0 {
	ieee80211-freq-limit = <2400000 2500000>, <5170000 5835000>, <5945000 7125000>;
};

&pcie3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie3_1_pins>;
	wifi-reset-gpios = <&pio 9 GPIO_ACTIVE_LOW>;
	wifi-reset-msleep = <100>;
	wifi-deassert-msleep = <500>;
	status = "okay";
};
