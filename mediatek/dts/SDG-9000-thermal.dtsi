#define SDG_CPU_THERMAL_MAP(_cname, _fan0, _fan1)			\
	polling-delay-passive = <0>;					\
	polling-delay = <1000>;						\
									\
	/delete-node/cooling-maps;					\
	/delete-node/trips;						\
									\
	trips {								\
		_cname##_critical: critical {				\
			temperature = <125000>;				\
			hysteresis = <4000>;				\
			type = "critical";				\
		};							\
		_cname##_hot: hot {					\
			temperature = <120000>;				\
			hysteresis = <4000>;				\
			type = "hot";					\
		};							\
		_cname##_active_high: active-high {			\
			temperature = <110000>;				\
			hysteresis = <4000>;				\
			type = "active";				\
		};							\
		_cname##_active_med: active-med {			\
			temperature = <80000>;				\
			hysteresis = <4000>;				\
			type = "active";				\
		};							\
		_cname##_active_low: active-low {			\
			temperature = <60000>;				\
			hysteresis = <4000>;				\
			type = "active";				\
		};							\
		_cname##_active_silent: active-silent {			\
			temperature = <40000>;				\
			hysteresis = <4000>;				\
			type = "active";				\
		};							\
	};								\
	cooling-maps {							\
		map3 {							\
			trip = <&_cname##_active_high>;			\
			cooling-device = <_fan0 3 3>, <_fan1 3 3>;	\
		};							\
		map2 {							\
			trip = <&_cname##_active_med>;			\
			cooling-device = <_fan0 2 2>, <_fan1 2 2>;	\
		};							\
		map1 {							\
			trip = <&_cname##_active_low>;			\
			cooling-device = <_fan0 1 1>, <_fan1 1 1>;	\
		};							\
		map0 {							\
			trip = <&_cname##_active_silent>;		\
			cooling-device = <_fan0 0 0>, <_fan1 0 0>;	\
		};							\
	}

