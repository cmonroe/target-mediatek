From: Chad Monroe <chad@monroe.io>
Date: Fri, 15 May 2026 13:42:43 -0700
Subject: [PATCH] net: ethernet: mtk_eth_soc: introduce PPPQ queue mapping

Compress sparse DSA port indices into a dense queue range so per-port
rate caps apply to offloaded traffic. Add eth->pppq_ofs[] (cumulative
user-port offsets per conduit GMAC) and mac->dsa_user_idx[] (DSA port to
dense index). mtk_select_queue() and mtk_device_event() compute
  queue = MTK_MAX_DEVS + pppq_ofs[mac->id] + dsa_user_idx[port]
for DSA, mac->id for direct GMAC. mtk_ppe_check_pppq_path() gates
offloader admission.

The topology is refreshed inside the DSA branch of mtk_device_event() on
NETDEV_CHANGE: at NETDEV_REGISTER the conduit/user-port lower-dev link
isn't wired up yet, so we can't recognise the port as ours. NETDEV_CHANGE
is the earliest event where the lower-dev walk succeeds.

Based-on-patch-by: chak-kei.lam <chak-kei.lam@mediatek.com>
Signed-off-by: Piotr Kubik <piotr.kubik@adtran.com>
Signed-off-by: Chad Monroe <chad@monroe.io>
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c |   83 +++++++++++++++++-
 drivers/net/ethernet/mediatek/mtk_eth_soc.h |   25 +++++
 2 files changed, 104 insertions(+), 4 deletions(-)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -3748,6 +3748,67 @@ static bool mtk_uses_dsa(struct net_devi
 #endif
 }
 
+/* Compute the PPPQ queue-range offset for each conduit GMAC.
+ *
+ * QDMA queue space layout:
+ *	0..MTK_MAX_DEVS-1	per-GMAC base queues for direct-GMAC traffic
+ *	MTK_MAX_DEVS..N-1	per-DSA-user-port queues, packed in order
+ *
+ * pppq_ofs[i] is the offset (counted in user ports) within the
+ * per-DSA region at which conduit GMAC i's user ports start. The
+ * sentinel pppq_ofs[MTK_MAX_DEVS] holds the total user-port count
+ * across all conduits, used to size the second half of the queue
+ * space for ACK partners.
+ */
+void mtk_eth_set_dsa_pppq_offset(struct mtk_eth *eth)
+{
+	struct net_device *dev;
+	int i, offset = 0;
+
+	for (i = 0; i < MTK_MAX_DEVS; i++) {
+		dev = eth->netdev[i];
+		if (dev && netdev_uses_dsa(dev)) {
+			eth->pppq_ofs[i] = offset;
+			offset += hweight32(dsa_user_ports(dev->dsa_ptr->ds));
+		}
+	}
+
+	eth->pppq_ofs[MTK_MAX_DEVS] = offset;
+}
+
+/* Enumerate DSA user ports on the switch behind @dev and assign each a
+ * sequential mac->dsa_user_idx[] slot. The DSA port index space can be
+ * sparse (CPU port, unused ports), but PPPQ needs a dense sequence so
+ * the per-port queue formula stays contiguous. Out-of-bounds indices
+ * (>= MTK_PPPQ_DSA_USER_PORTS) silently skip the table write;
+ * the offload admission gate filters them.
+ */
+void mtk_eth_set_dsa_user_idx(struct mtk_eth *eth, struct net_device *dev)
+{
+	const struct dsa_port *dp;
+	struct dsa_switch *ds;
+	struct mtk_mac *mac;
+	int p, cnt = 0;
+
+	if (!dsa_user_dev_check(dev))
+		return;
+
+	dp = dsa_port_from_netdev(dev);
+	ds = dp->cpu_dp->ds;
+	mac = netdev_priv(dp->cpu_dp->conduit);
+
+	for (p = 0; p < ds->num_ports; p++) {
+		if (!dsa_is_user_port(ds, p))
+			continue;
+
+		dp = dsa_to_port(ds, p);
+		if (dp->index < MTK_PPPQ_DSA_USER_PORTS)
+			mac->dsa_user_idx[dp->index] = cnt;
+
+		cnt++;
+	}
+}
+
 static int mtk_device_event(struct notifier_block *n, unsigned long event, void *ptr)
 {
 	struct mtk_mac *mac = container_of(n, struct mtk_mac, device_notifier);
@@ -3782,8 +3843,20 @@ found:
 		return NOTIFY_DONE;
 
 	if (dsa_user_dev_check(dev)) {
+		/* DSA topology can only be (re)resolved after the upper/lower
+		 * link to the conduit is wired up - NETDEV_REGISTER fires too
+		 * early. NETDEV_CHANGE is the earliest event where the lower-
+		 * dev walk above succeeds, so refresh the cached mapping here.
+		 */
+		mtk_eth_set_dsa_pppq_offset(eth);
+		mtk_eth_set_dsa_user_idx(eth, dev);
+
 		dp = dsa_port_from_netdev(dev);
-		queue = dp->index + 3;
+		if (dp->index < MTK_PPPQ_DSA_USER_PORTS)
+			queue = MTK_MAX_DEVS + eth->pppq_ofs[mac->id] +
+				mac->dsa_user_idx[dp->index];
+		else
+			queue = mac->id;
 
 		/* If the conduit GMAC link is the bottleneck, the per-port
 		 * PPPQ cap is redundant - skip it to leave the queue
@@ -5145,10 +5218,13 @@ static u16 mtk_select_queue(struct net_d
 			    struct net_device *sb_dev)
 {
 	struct mtk_mac *mac = netdev_priv(dev);
-	unsigned int queue = 0;
+	struct mtk_eth *eth = mac->hw;
+	unsigned int dp_index = skb_get_queue_mapping(skb);
+	unsigned int queue;
 
-	if (netdev_uses_dsa(dev))
-		queue = skb_get_queue_mapping(skb) + 3;
+	if (netdev_uses_dsa(dev) && dp_index < MTK_PPPQ_DSA_USER_PORTS)
+		queue = MTK_MAX_DEVS + eth->pppq_ofs[mac->id] +
+			mac->dsa_user_idx[dp_index];
 	else
 		queue = mac->id;
 
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.h
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.h
@@ -27,6 +27,7 @@
 #define MTK_DSA_PORT_MASK	GENMASK(2, 0)
 
 #define MTK_QDMA_NUM_QUEUES	32
+#define MTK_PPPQ_DSA_USER_PORTS	16
 #define MTK_QDMA_PAGE_SIZE	2048
 #define MTK_MAX_RX_LENGTH	1536
 #define MTK_MAX_RX_LENGTH_2K	2048
@@ -1449,6 +1450,7 @@ struct mtk_eth {
 	struct mtk_mux			*mux[MTK_MAX_DEVS];
 	int				irq[3];
 	u32				msg_enable;
+	u32				pppq_ofs[MTK_MAX_DEVS + 1];
 	unsigned long			sysclk;
 	struct regmap			*ethsys;
 	struct regmap			*infra;
@@ -1531,6 +1533,7 @@ struct mtk_mac {
 	int				hwlro_ip_cnt;
 	unsigned int			syscfg0;
 	struct notifier_block		device_notifier;
+	u8				dsa_user_idx[MTK_PPPQ_DSA_USER_PORTS];
 };
 
 /* struct mtk_mux_data -	the structure that holds the private data about the
@@ -1667,6 +1670,23 @@ static inline u32 mtk_get_ib2_multicast_
 	return MTK_FOE_IB2_MULTICAST;
 }
 
+/* mtk_ppe_check_pppq_path() -	gate the PPPQ stamping path
+ *
+ * Admit any DSA user port whose index fits in mac->dsa_user_idx[]
+ * (MTK_PPPQ_DSA_USER_PORTS slots), and any direct-GMAC (non-DSA) egress.
+ * Reject anything else, so the PPE offloader can skip the queue-assignment
+ * block and let the flow take the default PSE port. The widened gate
+ * covers larger DSA fabrics (e.g. the MXL86282) and direct-GMAC-only
+ * SKUs where the historic "<= 4" cap silently dropped PPPQ.
+ */
+static inline bool mtk_ppe_check_pppq_path(int dsa_port)
+{
+	if (dsa_port < 0)
+		return true;
+
+	return dsa_port < MTK_PPPQ_DSA_USER_PORTS;
+}
+
 static inline bool mtk_interface_mode_is_xgmii(phy_interface_t interface)
 {
 	switch (interface) {
@@ -1723,4 +1743,7 @@ static inline bool mtk_qtx_sch_is_v3_lay
 	       eth->soc->caps != MT7988_CAPS;
 }
 
+void mtk_eth_set_dsa_pppq_offset(struct mtk_eth *eth);
+void mtk_eth_set_dsa_user_idx(struct mtk_eth *eth, struct net_device *dev);
+
 #endif /* MTK_ETH_H */
