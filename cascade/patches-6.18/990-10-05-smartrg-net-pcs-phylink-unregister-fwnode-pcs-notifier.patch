From: Piotr Kubik <piotr.kubik@adtran.com>
Date: Wed, 8 Jul 2026 21:30:00 +0200
Subject: [PATCH] net: pcs: phylink: unregister fwnode PCS notifier on destroy

phylink_create() registers pl->fwnode_pcs_nb on the global fwnode PCS
provider notifier chain, but phylink_destroy() never removes it, and
no unregister helper exists at all. Every destroyed phylink instance
leaves a dangling notifier_block on the chain pointing into freed
memory.

Drivers that destroy and re-create phylink instances at runtime (the
mtk_eth_soc ethernet-mux does this on every SFP insertion or removal)
corrupt the chain within a few cycles. Observed after repeated SFP
hotplugs, first as

  notifier callback pcs_provider_notify already registered

(when the new instance was allocated at the address of the leaked
one), then as a fatal chain walk into freed memory:

  Unable to handle kernel paging request at 000700088a010010
  pc : notifier_chain_register+0x24/0x100
  Call trace:
   notifier_chain_register+0x24/0x100 (P)
   blocking_notifier_chain_register+0x3c/0x80
   register_fwnode_pcs_notifier+0x20/0x30
   phylink_create+0x494/0xb50
   mux_poll+0x144/0x218

Add unregister_fwnode_pcs_notifier() and call it in
phylink_destroy(). Also move the registration in phylink_create()
after the last point of failure so no error path can leak a
registration either.

--- a/drivers/net/pcs/pcs.c
+++ b/drivers/net/pcs/pcs.c
@@ -30,6 +30,12 @@ int register_fwnode_pcs_notifier(struct
 }
 EXPORT_SYMBOL_GPL(register_fwnode_pcs_notifier);
 
+int unregister_fwnode_pcs_notifier(struct notifier_block *nb)
+{
+	return blocking_notifier_chain_unregister(&fwnode_pcs_notify_list, nb);
+}
+EXPORT_SYMBOL_GPL(unregister_fwnode_pcs_notifier);
+
 struct phylink_pcs *fwnode_pcs_simple_get(struct fwnode_reference_args *pcsspec,
 					  void *data)
 {
--- a/drivers/net/phy/phylink.c
+++ b/drivers/net/phy/phylink.c
@@ -2103,11 +2103,6 @@ struct phylink *phylink_create(struct ph
 				 pl->supported_interfaces,
 				 pcs->supported_interfaces);
 
-	if (!phy_interface_empty(config->pcs_interfaces)) {
-		pl->fwnode_pcs_nb.notifier_call = pcs_provider_notify;
-		register_fwnode_pcs_notifier(&pl->fwnode_pcs_nb);
-	}
-
 	pl->config = config;
 	if (config->type == PHYLINK_NETDEV) {
 		pl->netdev = to_net_dev(config->dev);
@@ -2164,6 +2159,15 @@ struct phylink *phylink_create(struct ph
 	if (ret < 0)
 		goto release_link_gpio;
 
+	/* Register for PCS provider notifications only after the last
+	 * point of failure, so that no error path can leak the notifier
+	 * registration into the chain.
+	 */
+	if (!phy_interface_empty(config->pcs_interfaces)) {
+		pl->fwnode_pcs_nb.notifier_call = pcs_provider_notify;
+		register_fwnode_pcs_notifier(&pl->fwnode_pcs_nb);
+	}
+
 	return pl;
 
 release_link_gpio:
@@ -2188,6 +2192,10 @@ void phylink_destroy(struct phylink *pl)
 {
 	struct phylink_pcs *pcs, *tmp;
 
+	/* Safe also when phylink_create() did not register the notifier:
+	 * removal of a block that is not on the chain returns -ENOENT.
+	 */
+	unregister_fwnode_pcs_notifier(&pl->fwnode_pcs_nb);
 	sfp_bus_del_upstream(pl->sfp_bus);
 	if (pl->link_gpio)
 		gpiod_put(pl->link_gpio);
--- a/include/linux/pcs/pcs.h
+++ b/include/linux/pcs/pcs.h
@@ -23,6 +23,19 @@ enum fwnode_pcs_notify_event {
 int register_fwnode_pcs_notifier(struct notifier_block *nb);
 
 /**
+ * unregister_fwnode_pcs_notifier - Unregister a notifier block for
+ *				    fwnode PCS events
+ * @nb: pointer to the notifier block
+ *
+ * Removes a notifier block from the fwnode_pcs_notify_list blocking
+ * notifier chain. Must be called before the structure embedding @nb
+ * is freed.
+ *
+ * Returns 0 or a negative error.
+ */
+int unregister_fwnode_pcs_notifier(struct notifier_block *nb);
+
+/**
  * fwnode_pcs_get - Retrieves a PCS from a firmware node
  * @fwnode: firmware node
  * @index: index fwnode PCS handle in firmware node
@@ -79,6 +92,11 @@ static inline int register_fwnode_pcs_no
 {
 	return -EOPNOTSUPP;
 }
+
+static inline int unregister_fwnode_pcs_notifier(struct notifier_block *nb)
+{
+	return -EOPNOTSUPP;
+}
 
 static inline struct phylink_pcs *fwnode_pcs_get(struct fwnode_handle *fwnode,
 						 int index)
